generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id                  String          @id @default(cuid())
  source              String
  externalId          String          @map("external_id")
  title               String
  company             String
  location            String
  salary              String?
  applyUrl            String?         @map("apply_url")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  lastSeenAt          DateTime        @default(now()) @map("last_seen_at")
  appliedAt           DateTime?       @map("applied_at")
  notes               String?
  platform            String?
  status              String?
  description         String?
  fingerprint         String?
  telegram_channel_id String?
  telegram_message_id String?
  applications        Application[]
  resumes             ResumeVersion[]

  @@unique([source, externalId])
  @@index([source])
  @@index([company])
  @@index([status])
  @@index([fingerprint])
}

model Application {
  id              String          @id @default(cuid())
  jobId           String          @map("job_id")
  userId          String          @default("default-user") @map("user_id")
  status          String
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  appliedAt       DateTime?       @map("applied_at")
  errorMessage    String?         @map("error_message")
  resumeVersionId String?         @map("resume_version_id")
  job             Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeVersion   ResumeVersion?  @relation("AppToResume", fields: [resumeVersionId], references: [id])
  resumeVersions  ResumeVersion[] @relation("JobAppResumes")

  @@index([jobId])
  @@index([userId])
  @@index([status])
}

model ResumeVersion {
  id            String        @id @default(cuid())
  applicationId String        @map("application_id")
  jobId         String        @map("job_id")
  pdfPath       String        @map("pdf_path")
  latexPath     String        @map("latex_path")
  generatedAt   DateTime      @default(now()) @map("generated_at")
  applications  Application[] @relation("AppToResume")
  application   Application   @relation("JobAppResumes", fields: [applicationId], references: [id], onDelete: Cascade)
  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([jobId])
}

model Lead {
  id             String    @id @default(cuid())
  companyName    String    @map("company_name")
  recipientEmail String    @map("recipient_email")
  jobDescription String    @map("job_description")
  status         String    @default("READY")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  thread_id      String?
  userId         String    @default("default-user") @map("user_id")
  messages       Message[]

  @@index([userId])
  @@map("leads")
}

model Message {
  id               String    @id @default(cuid())
  leadId           String    @map("lead_id")
  type             String
  subject          String
  body             String
  sentAt           DateTime? @map("sent_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  gmail_message_id String?
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model User {
  id                String      @id @default(cuid())
  email             String?     @unique
  displayName       String?     @map("display_name")
  avatarUrl         String?     @map("avatar_url")
  username          String      @unique
  role              Role        @default(USER)
  is2FaAuthEnabled  Boolean     @default(false) @map("is2fa_auth_enabled")
  isBanned          Boolean     @default(false) @map("is_banned")
  isEmailVerified   Boolean     @default(false) @map("is_email_verified")
  verificationToken String?     @map("verification_token")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  authMethods       AuthMethod?

  profile       UserProfile?
  experiences   UserExperience[]
  educations    UserEducation[]
  skills        UserSkill[]
  preferences   UserPreference?
  customAnswers UserCustomAnswer[]

  @@map("user")
}

model AuthMethod {
  id           String       @id @default(cuid())
  userId       String       @unique @map("user_id")
  provider     AuthProvider
  googleSub    String?      @unique @map("google_sub")
  googleEmail  String?      @unique @map("google_email")
  githubSub    String?      @unique @map("github_sub")
  githubEmail  String?      @unique @map("github_email")
  email        String?
  passwordHash String?      @map("password_hash")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_method")
}

model conversation_trackers {
  id                String    @id
  profile_id        String    @unique
  status            String    @default("ACTIVE")
  last_contacted_at DateTime?
  reply_received    Boolean   @default(false)
  positive_response Boolean   @default(false)
  profiles          profiles  @relation(fields: [profile_id], references: [id], onDelete: Cascade)
}

model generation_jobs {
  id                String    @id
  profile_id        String
  resume_id         String
  job_id            String?
  template_id       String
  status            String    @default("PENDING")
  generated_subject String?
  generated_message String?
  error             String?
  created_at        DateTime  @default(now())
  profiles          profiles  @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  resumes           resumes   @relation(fields: [resume_id], references: [id], onDelete: Cascade)
  templates         templates @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@index([profile_id])
  @@index([resume_id])
  @@index([template_id])
}

model google_tokens {
  id            String   @id @default("singleton")
  access_token  String
  refresh_token String
  expiry_date   DateTime
  updated_at    DateTime
}

model outbound_messages {
  id           String    @id
  profile_id   String
  channel      String    @default("EMAIL")
  subject      String
  content      String
  status       String    @default("DRAFT")
  sent_at      DateTime?
  delivered_at DateTime?
  created_at   DateTime  @default(now())
  profiles     profiles  @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([profile_id])
  @@index([status])
}

model profiles {
  id                    String                 @id
  name                  String
  role                  String
  company               String
  linkedin_url          String?
  email                 String?
  notes                 String?
  source                String                 @default("MANUAL")
  tags                  String[]
  created_at            DateTime               @default(now())
  updated_at            DateTime
  user_id               String                 @default("default-user")
  conversation_trackers conversation_trackers?
  generation_jobs       generation_jobs[]
  outbound_messages     outbound_messages[]

  @@index([user_id])
}

model resumes {
  id              String            @id
  title           String
  file_url        String?
  parsed_text     String
  skills          String[]
  experience      String?
  projects        String?
  created_at      DateTime          @default(now())
  generation_jobs generation_jobs[]
}

model telegram_channels {
  id         String   @id
  channel_id String   @unique
  title      String
  username   String?
  created_at DateTime @default(now())
}

model telegram_messages {
  id            String   @id
  channel_id    String
  channel_name  String
  message_id    Int
  message_text  String
  posted_at     DateTime
  processed     Boolean  @default(false)
  status        String   @default("UNPROCESSED")
  error_message String?
  created_at    DateTime @default(now())

  @@unique([channel_id, message_id])
}

model templates {
  id              String            @id
  name            String
  type            String
  prompt          String
  active          Boolean           @default(true)
  created_at      DateTime          @default(now())
  generation_jobs generation_jobs[]
}

enum Role {
  ADMIN
  AUTHOR
  USER
}

enum AuthProvider {
  GOOGLE_OAUTH
  GITHUB_OAUTH
  EMAIL_PASSWORD
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  fullName        String?  @map("full_name")
  email           String?
  phone           String?
  location        String?
  linkedinUrl     String?  @map("linkedin_url")
  githubUrl       String?  @map("github_url")
  portfolioUrl    String?  @map("portfolio_url")
  currentRole     String?  @map("current_role")
  currentCompany  String?  @map("current_company")
  experienceYears Int?     @map("experience_years")
  currentSalary   String?  @map("current_salary")
  expectedSalary  String?  @map("expected_salary")
  noticePeriod    String?  @map("notice_period")
  resumeUrl       String?  @map("resume_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserExperience {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  company     String
  role        String
  description String?
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_experience")
}

model UserEducation {
  id        String @id @default(cuid())
  userId    String @map("user_id")
  degree    String
  college   String
  startYear Int    @map("start_year")
  endYear   Int?   @map("end_year")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_education")
}

model UserSkill {
  id        String @id @default(cuid())
  userId    String @map("user_id")
  skillName String @map("skill_name")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_skills")
}

model UserPreference {
  id                  String  @id @default(cuid())
  userId              String  @unique @map("user_id")
  authorizedToWork    Boolean @default(false) @map("authorized_to_work")
  needVisaSponsorship Boolean @default(false) @map("need_visa_sponsorship")
  openToRelocation    Boolean @default(false) @map("open_to_relocation")
  openToRemoteRoles   Boolean @default(false) @map("open_to_remote_roles")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserCustomAnswer {
  id       String @id @default(cuid())
  userId   String @map("user_id")
  question String
  answer   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_custom_answers")
}
